# ---------------------------------------------------------------
# Copy to .env.local for `vercel dev`, and set the same values in
# Vercel → Project → Settings → Environment Variables.
# Never commit real values.
# ---------------------------------------------------------------

# Which try-on engine to use: "fashn" (real, costs credits) or "mock" (free, for UI work).
TRYON_PROVIDER=mock

# FASHN API key from https://app.fashn.ai/api — server-side only, never put it in the app.
FASHN_API_KEY=

# Long random string used to sign job tokens. Generate with:  openssl rand -hex 32
JOB_TOKEN_SECRET=

# Shared key the app sends in the `x-app-key` header. Generate with: openssl rand -hex 16
# Put the same value in app/.env as EXPO_PUBLIC_APP_KEY.
APP_CLIENT_KEY=

# --- Credit protection (you have ~100 FASHN credits) ---
# Max try-ons per IP address per hour.
RATE_LIMIT_PER_HOUR=5
# Max try-ons for the whole service per UTC day. Hard stop to protect credits.
DAILY_TRYON_CAP=25

# Optional but recommended in production: Upstash Redis (free tier, add via
# Vercel → Storage → Marketplace → Upstash). Without it, limits are kept in memory
# per server instance, which is best-effort only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Mock provider only: how long a fake try-on takes, and an optional forced outcome
# ("success" | "fail") for testing error screens.
MOCK_DELAY_MS=4000
MOCK_OUTCOME=success
