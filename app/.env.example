# App settings. Copy this file to `.env` (cp .env.example .env) and the app is ready to run.
#
# The values below point at the live BRB try-on server, so `npx expo start` + Expo Go
# works straight after cloning. The app key is not a secret: it is visible inside any
# shipped app or web build. Real protection is the server-side limits (see README).
#
# To use a server on your own laptop instead: http://<your-laptop-Wi-Fi-IP>:3000
EXPO_PUBLIC_API_BASE_URL=https://brb-tryon.vercel.app
EXPO_PUBLIC_APP_KEY=9ca2021d233d6f45bd3ab428a22711f1
